# ---- OpenRouteService (free key: https://openrouteservice.org/dev/#/signup) ----
ORS_API_KEY=replace_me

# ---- TigerData / Tiger Cloud connection string ----
# Tiger Cloud console -> your service -> Connection info -> Service URL
# Looks like: postgres://tsdbadmin:PASSWORD@xxxx.xxxx.tsdb.cloud.timescale.com:35123/tsdb?sslmode=require
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:35123/tsdb?sslmode=require

# ---- Behavior ----
# Comma-separated US state codes to ingest flood alerts + gauges for.
INGEST_STATES=TX,LA
# Set to false to run the API without the background ingest scheduler.
ENABLE_SCHEDULER=true
# Serve fixture data instead of calling live APIs (lets the frontends work offline).
USE_FIXTURES=false
